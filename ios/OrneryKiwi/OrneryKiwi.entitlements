<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      App Group shared with the Share Extension.
      Both targets must have this group registered in your Apple Developer account.
      Settings → Signing & Capabilities → + Capability → App Groups
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.ornery-kiwi.shared</string>
    </array>
</dict>
</plist>
