<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Must match OrneryKiwi.entitlements exactly.
      Register group.com.ornery-kiwi.shared in your Apple Developer account
      under Identifiers → App Groups before building.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.ornery-kiwi.shared</string>
    </array>
</dict>
</plist>
