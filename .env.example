# ── Ornery-Kiwi environment configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.

# AI provider: "claude" (default) or "openai"
AI_PROVIDER=claude

# Anthropic — required when AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI — required when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Optional: Watch folder — defaults to ~/Documents/ReelCapture/watch
# Point this at any folder, e.g. a Desktop drop folder
# WATCH_DIR=~/Desktop/Drop Screenshots Here

# Optional: Whisper model size — tiny | base | small | medium | large
# Larger = more accurate, slower. "base" is a good default.
# WHISPER_MODEL=base

# Optional: Path to your Google OAuth credentials JSON
# Download from Google Cloud Console → APIs & Services → Credentials
# GOOGLE_CREDENTIALS_PATH=/home/user/Documents/ReelCapture/credentials.json

# Optional: Name of the Google Drive folder to sync into
# GDRIVE_FOLDER_NAME=ReelCapture
