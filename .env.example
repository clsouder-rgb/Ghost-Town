# ── Ornery-Kiwi environment configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.

# AI provider: "claude" (default) or "openai"
AI_PROVIDER=claude

# Anthropic — required when AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI — required when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Evidence Library governance ─────────────────────────────────────────────

# Kill switch: disable ALL auto-ingest from the pipeline.
# Pipeline continues normally when set. Manual POST /evidence/ingest still works.
# EVIDENCE_INGEST_DISABLED=1

# Minimum viability score (0–10) for pipeline results to be auto-ingested.
# Score 0-3 = junk/noise, 4-6 = medium value, 7-10 = high value.
# Default: 4 (filters out low-value screenshots like login screens, receipts, etc.)
# Set to 0 to ingest everything; raise to 7 to ingest only high-value content.
# EVIDENCE_MIN_SCORE=4

# Title similarity threshold (0.0–1.0) for near-duplicate detection.
# Records whose titles match an existing title above this ratio are skipped.
# Default: 0.85 (85% similar). Lower = stricter, Higher = more permissive.
# EVIDENCE_TITLE_SIMILARITY=0.85

# Optional: Obsidian vault path for auto-export.
# Every ingested record is immediately written as a .md file to this folder.
# iCloud vault example (replace "clinical focus" with your actual vault name):
# OBSIDIAN_VAULT=~/Library/Mobile Documents/iCloud~md~obsidian/Documents/clinical focus
# Local vault example:
# OBSIDIAN_VAULT=~/Documents/Obsidian/Evidence

# Optional: Base storage directory — defaults to ~/Documents/ReelCapture
# Point this at an external drive to store the database and outputs there
# BASE_DIR=/Volumes/MyDrive/ReelCapture

# Optional: API server binding (localhost vs network)
# 127.0.0.1 = localhost only (default, safe without auth)
# 0.0.0.0 = network accessible (requires API_TOKEN for writes)
# API_HOST=127.0.0.1
# API_PORT=8000

# Optional: API token for remote access (required if API_HOST=0.0.0.0)
# Generate a strong token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_TOKEN=your-token-here

# Optional: Watch folder — defaults to ~/Documents/ReelCapture/watch
# Point this at any folder, e.g. your Desktop drop folder.
# Media files (video/image) → Ornery-Kiwi pipeline
# Document files (pdf/docx/txt/md) → Evidence Library auto-ingest
# WATCH_DIR=~/Desktop/📥 Drop Screenshots Here

# Optional: Whisper model size — tiny | base | small | medium | large
# Larger = more accurate, slower. "base" is a good default.
# WHISPER_MODEL=base

# Optional: Path to your Google OAuth credentials JSON
# Download from Google Cloud Console → APIs & Services → Credentials
# GOOGLE_CREDENTIALS_PATH=/home/user/Documents/ReelCapture/credentials.json

# Optional: Name of the Google Drive folder to sync into
# GDRIVE_FOLDER_NAME=ReelCapture
